# Copy this file to nuru.local.env and fill in your own values.
# nuru.local.env is gitignored - it never gets committed.
# All settings are optional; anything left unset just means that
# feature shows a friendly "not configured" message until you set it.

# --- Email automation (SMTP) ---
# Gmail: smtp.gmail.com, port 587, and an App Password (not your regular
# password) from https://myaccount.google.com/apppasswords
NURU_SMTP_HOST=
NURU_SMTP_PORT=587
NURU_SMTP_USER=
NURU_SMTP_PASSWORD=
NURU_SMTP_FROM=

# --- Webhook automation ---
# A Zapier "Catch Hook" URL, a Make.com scenario webhook, or any endpoint
# you control. Pre-fills the review screen; still editable per document.
NURU_WEBHOOK_URL=

# Webhook destinations are checked before sending: link-local addresses
# (this is where cloud metadata endpoints live) and other reserved ranges
# are always blocked. Loopback and private (RFC1918) addresses are allowed
# by default, since a self-hosted receiver on the same machine or LAN is
# normal for a single-user setup. Set this to true to also block those —
# do that the moment more than one trusted person can trigger a send.
NURU_WEBHOOK_PUBLIC_ONLY=false

# --- Email automation default recipient ---
# Pre-fills the "Email it" destination address, e.g. a standing AP inbox.
NURU_DEFAULT_EMAIL_TO=

# --- Access gate ---
# If set, every page requires this password via HTTP Basic Auth. Leave
# unset for local-only use on 127.0.0.1 (the default).
NURU_ACCESS_PASSWORD=

# --- Archive automation ---
# Default destination folder for the "Archive the file" action.
NURU_ARCHIVE_DIR=

# Additional folders an administrator has approved as archive destinations,
# separated by the OS path separator (";" on Windows, ":" elsewhere). The
# review screen only ever offers a dropdown of these approved folders plus
# NURU_ARCHIVE_DIR — never a free-text path — so a document can't be
# written somewhere unintended just because someone typed a path.
NURU_ARCHIVE_ALLOWED_ROOTS=

# --- Secret key ---
# Signs CSRF tokens. If unset, one is generated automatically on first run
# and saved to .nuru_cache/secret_key so it survives restarts. Set this
# explicitly if you run more than one Nuru process behind a load balancer.
NURU_SECRET_KEY=

# --- Retention ---
# A document that's scanned but never reviewed to completion (someone
# closed the tab, walked away) is auto-purged after this many hours: its
# cached source file is deleted and it's marked done, same as an explicit
# discard. Keeps "gone the moment automation completes" true even when a
# review gets abandoned rather than finished.
NURU_REVIEW_TTL_HOURS=24
